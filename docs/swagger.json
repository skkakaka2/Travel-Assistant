        "/api/v1/review/create": {
            "post": {
                "description": "创建行程复盘，包含酒店评分",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Review"
                ],
                "summary": "创建复盘",
