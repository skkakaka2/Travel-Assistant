                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Trip"
                ],
                "summary": "更新行程",
                "parameters": [
                    {
                        "description": "更新行程请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
