                            "$ref": "#/definitions/reviewservice.UserStatsResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/review/trips/available": {
            "get": {
                "description": "获取已结束且未复盘的行程列表",
                "consumes": [
                    "application/json"
                ],
